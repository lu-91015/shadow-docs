---
layout: null
permalink: /search.json
---
[
{% assign search_pages = site.pages | where_exp: "p", "p.title != nil and p.url != '/search.json'" %}
{% for p in search_pages %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | jsonify }},
    "summary": {{ p.summary | default: "" | jsonify }},
    "text": {{ p.content | strip_html | strip_newlines | replace: "  ", " " | replace: "  ", " " | truncatewords: 60 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
